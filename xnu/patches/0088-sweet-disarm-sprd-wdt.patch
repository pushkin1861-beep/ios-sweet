 /*
+ * Spreadtrum AP watchdog (DT node watchdog@644e0000, "sprd,wdt-r2p0-fiq").
+ * LK arms it (uboot_a strings: "AP_WATCHDOG_REBOOT", "setwatchdog",
+ * "wdgreboot"); Android feeds it, but nothing in this kernel does, so on
+ * a slow bring-up boot the SoC hard-resets after LK's timeout and the
+ * phone loops. Registers per drivers/watchdog/sprd_wdt.c (r2p0 family):
+ *   0x00 LOAD_LOW   0x04 LOAD_HIGH  0x08 CTRL      0x0c INT_CLR
+ *   0x10 INT_RAW    0x14 INT_MSK    0x18 CNT_LOW   0x1c CNT_HIGH
+ *   0x20 LOCK       0x2c/0x30 IRQ_LOAD
+ * CTRL: bit0 INT_EN, bit1 CNT_EN, bit2 NEW_VER_EN, bit3 RST_EN.
+ * Unlock with 0xE551 written to LOCK, 0 re-locks. 1-s tick = 32768.
+ * Disarm once at bsd_init start; `sweetwdt=2` leaves it alone.
+ */
+#define SWEET_WDT_PA        0x644e0000u
+#define SWEET_WDT_SIZE      0x1000u
+#define SWEET_WDT_CTRL      0x08u
+#define SWEET_WDT_INT_CLR   0x0cu
+#define SWEET_WDT_INT_RAW   0x10u
+#define SWEET_WDT_CNT_LOW   0x18u
+#define SWEET_WDT_CNT_HIGH  0x1cu
+#define SWEET_WDT_LOCK      0x20u
+#define SWEET_WDT_UNLOCK    0xe551u
+#define SWEET_WDT_INT_EN    (1u << 0)
+#define SWEET_WDT_CNT_EN    (1u << 1)
+#define SWEET_WDT_RST_EN    (1u << 3)
+#define SWEET_WDT_INT_CLEAR (1u << 0)
+#define SWEET_WDT_RST_CLEAR (1u << 3)
+
+static inline void
+sweet_wdt_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dmb osh" ::: "memory");
+}
+
+static inline uint32_t
+sweet_wdt_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static uint64_t
+sweet_wdt_count(vm_offset_t base)
+{
+	uint64_t hi = sweet_wdt_rd(base, SWEET_WDT_CNT_HIGH);
+	uint64_t lo = sweet_wdt_rd(base, SWEET_WDT_CNT_LOW) & 0xffffu;
+	return (hi << 16) | lo;
+}
+
+void
+sweet_wdt_disarm(void)
+{
+	uint32_t keep = 0;
+	(void)PE_parse_boot_argn("sweetwdt", &keep, sizeof(keep));
+	if (keep == 2u) {
+		printf("SWEET WDT: sweetwdt=2, leaving sprd-wdt as-is\n");
+		return;
+	}
+	vm_offset_t base = ml_io_map(SWEET_WDT_PA, SWEET_WDT_SIZE);
+	if (base == 0) {
+		printf("SWEET WDT: ml_io_map failed\n");
+		return;
+	}
+	uint32_t ctrl_before = sweet_wdt_rd(base, SWEET_WDT_CTRL);
+	uint32_t raw_before = sweet_wdt_rd(base, SWEET_WDT_INT_RAW);
+	uint64_t cnt_a = sweet_wdt_count(base);
+	sweet_wdt_wr(base, SWEET_WDT_LOCK, SWEET_WDT_UNLOCK);
+	sweet_wdt_wr(base, SWEET_WDT_CTRL,
+	    ctrl_before & ~(SWEET_WDT_INT_EN | SWEET_WDT_CNT_EN | SWEET_WDT_RST_EN));
+	sweet_wdt_wr(base, SWEET_WDT_INT_CLR, SWEET_WDT_INT_CLEAR | SWEET_WDT_RST_CLEAR);
+	sweet_wdt_wr(base, SWEET_WDT_LOCK, 0);
+	delay(200000); /* ~6 ticks of the 32.768 kHz counter */
+	uint32_t ctrl_after = sweet_wdt_rd(base, SWEET_WDT_CTRL);
+	uint64_t cnt_b = sweet_wdt_count(base);
+	printf("SWEET WDT: sprd-wdt disarmed: ctrl %#x -> %#x, int_raw %#x, cnt %llu -> %llu (%s)\n",
+	    ctrl_before, ctrl_after, raw_before, cnt_a, cnt_b,
+	    cnt_a == cnt_b ? "counter frozen" : "COUNTER STILL RUNNING");
+}
