+/*
+ * Boot-arg exec_inject: inject DYLD_INSERT_LIBRARIES into selected processes
+ * at exec time. Entries are separated by ';', with library path followed by
+ * ',' or space-separated process basenames (default: "/lib/libfix.dylib,lsd";
+ * "-" disables injection).
+ */
+static TUNABLE_STR(exec_inject, 512, "exec_inject", "/lib/libfix.dylib,lsd");
+
+static size_t
+exec_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	if (exec_inject[0] == '\0' || exec_inject[0] == '-' || imgp->ip_strings == NULL) {
+		return 0;
+	}
+	const char *base = strrchr(imgp->ip_strings, '/');
+	base = (base != NULL) ? base + 1 : imgp->ip_strings;
+	size_t blen = strlen(base);
+	if (blen == 0) {
+		return 0;
+	}
+	size_t pos = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	size_t prefix = pos;
+	const char *spec = exec_inject;
+	while (*spec != '\0') {
+		const char *next = strchr(spec, ';');
+		const char *end = next ? next : spec + strlen(spec);
+		const char *sep = spec;
+		while (sep < end && *sep != ',' && *sep != ' ') {
+			sep++;
+		}
+		size_t liblen = (size_t)(sep - spec);
+		bool match = (sep == end);
+		const char *t = (sep < end) ? sep + 1 : end;
+		while (!match && t < end) {
+			while (t < end && (*t == ',' || *t == ' ')) {
+				t++;
+			}
+			const char *te = t;
+			while (te < end && *te != ',' && *te != ' ') {
+				te++;
+			}
+			if ((size_t)(te - t) == blen && strncmp(t, base, blen) == 0) {
+				match = true;
+			}
+			t = te;
+		}
+		if (match && liblen > 0) {
+			if (pos + (pos > prefix ? 1 : 0) + liblen >= size) {
+				return 0;
+			}
+			if (pos > prefix) {
+				env[pos++] = ':';
+			}
+			memcpy(env + pos, spec, liblen);
+			pos += liblen;
+			env[pos] = '\0';
+		}
+		spec = next ? next + 1 : end;
+	}
+	return pos > prefix ? pos : 0;
+}
