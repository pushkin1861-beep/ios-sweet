+/*
+ * (sweet) Bring-up aid: the boot-arg execinject holds "LIBRARY,NAME[,NAME...]"; every
+ * program whose file name is one of the NAMEs is started with DYLD_INSERT_LIBRARIES=LIBRARY
+ * in its environment, so that dyld loads our library into it (dyld takes several libraries
+ * separated by ":" inside the one LIBRARY). launchd refuses to pass DYLD_ variables from a
+ * job description, which is why the kernel adds this one itself, here in
+ * exec_extract_strings, ahead of every environment string the caller passed; nothing
+ * filters DYLD_ out afterwards. The whole configuration is one string, hence the buffer
+ * (512 bytes have been lost to silent truncation before).
+ */
+static TUNABLE_STR(exec_inject_conf, 4096, "execinject", "");
+
+static bool
+exec_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	const char *p = exec_inject_conf;
+	const char *libs, *name;
+	size_t liblen, namelen, pfx;
+
+	libs = p;
+	while (*p != 0 && *p != ',') {
+		p++;
+	}
+	liblen = (size_t)(p - libs);
+	if (liblen == 0 || *p == 0) {
+		return false;
+	}
+	p++;
+	if (imgp->ip_ndp == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	if (namelen == 0) {
+		return false;
+	}
+	while (*p != 0) {
+		const char *word = p;
+
+		while (*p != 0 && *p != ',') {
+			p++;
+		}
+		if ((size_t)(p - word) == namelen && strncmp(word, name, namelen) == 0) {
+			pfx = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+			if (pfx + liblen >= size) {
+				return false;
+			}
+			memcpy(env + pfx, libs, liblen);
+			env[pfx + liblen] = '\0';
+			return true;
+		}
+		if (*p == ',') {
+			p++;
+		}
+	}
+	return false;
+}
