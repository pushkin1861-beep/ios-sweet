 	}
 	printf("SMP %s[%d] slide 0x%llx mh 0x%llx\n", name, pid, slide, task->mach_header_vm_address);
 
+	/* Under the task lock only the registers are captured; the user-memory
+	 * backtrace walk (vm_map_read_user can block on faults) and printing
