+		int n;
+		uint64_t fp = regs[tn].fp;
+
+		n = snprintf(line, sizeof(line), "SMP %s t%u pc 0x%llx lr 0x%llx sp 0x%llx bt", name, tn,
+		    regs[tn].pc, regs[tn].lr, regs[tn].sp);
+		if (n < 0 || (size_t)n >= sizeof(line)) {
+			n = (int)sizeof(line) - 1;
+		}
 		for (int i = 0; i < 16 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
