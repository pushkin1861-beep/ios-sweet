 	}
 	memcpy(rdata, buf, rlen);
 	return 0;
@@ -351,6 +358,10 @@
 static void
 touch_probe(void)
 {
+	uint8_t fw[4];
+	int fwerr = tcs_read8(0, 3, fw, sizeof(fw));	/* FW id, vendor first cmd */
+	printf("SWEET TOUCH: fw id %s %02x %02x %02x %02x\n",
