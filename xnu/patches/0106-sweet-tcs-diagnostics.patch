diff -ruN a/bsd/dev/sweet_input.c b/bsd/dev/sweet_input.c
--- a/bsd/dev/sweet_input.c	2026-10-30 10:20:13.235948193 +0300
+++ b/bsd/dev/sweet_input.c	2026-10-30 10:40:20.644645095 +0300
@@ -293,11 +293,18 @@
 	if (spi_rx(buf, rlen + 5) != 0) {
 		return -1;
 	}
-	if (buf[rlen] != 0) {		/* ecode */
-		return -1;
-	}
-	if (crc16(buf, rlen + 3) != (uint16_t)(buf[rlen + 3] | (buf[rlen + 4] << 8))) {
-		return -2;
+	if (buf[rlen] != 0 || crc16(buf, rlen + 3) !=
+	    (uint16_t)(buf[rlen + 3] | (buf[rlen + 4] << 8))) {
+		unsigned show = rlen + 5 > 16 ? 16 : rlen + 5;
+		printf("SWEET TOUCH: tcs rd c%u cmd%u ecode=%x crc=%s:", class, id,
