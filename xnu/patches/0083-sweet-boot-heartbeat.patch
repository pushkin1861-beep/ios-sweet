new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_boot.c
@@ -0,0 +1,66 @@
+/*
+ * SWEET boot progress trace.
+ *
+ * During bring-up the console can stop at any point and a photograph of a
+ * frozen screen cannot tell a dead kernel from one that is alive with its
+ * console output stuck. This adds two independent signs of life:
+ *
+ *  - sweet_boot_mark() prints (and remembers) the last boot milestone, so a
+ *    heartbeat names the place the boot stopped at;
+ *  - a kernel thread prints "SWEET ALIVE <beat> ..." every two seconds and
+ *    paints a growing bar straight into the panel through the framebuffer
+ *    console's mapping (pexpert/arm/pe_serial.c), bypassing the console
+ *    ring, so the screen keeps changing even if console output dies.
+ *
+ * Boot-arg sweetheartbeat=0 disables the heartbeat thread.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+
+extern void sweet_fbcon_alive(unsigned int beat, int stage);
+
+volatile int sweet_boot_stage;
+static const char *sweet_boot_label = "start";
+
+void
+sweet_boot_mark(int stage, const char *label)
+{
+	sweet_boot_label = label;
+	sweet_boot_stage = stage;
+	printf("SWEET STAGE %d: %s\n", stage, label);
+	sweet_fbcon_alive(0, stage);
+}
+
+static void
+sweet_heartbeat(void *arg __unused, wait_result_t wr __unused)
+{
+	unsigned int beat = 0;
+
+	for (;;) {
+		delay_for_interval(2000, 1000 * 1000);
+		beat++;
+		sweet_fbcon_alive(beat, sweet_boot_stage);
+		printf("SWEET ALIVE %u: stage %d (%s)\n", beat, sweet_boot_stage, sweet_boot_label);
+	}
+}
+
+void
+sweet_boot_heartbeat(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetheartbeat", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	if (kernel_thread_start(sweet_heartbeat, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
