+/*
+ * Liveness bar for bsd/dev/sweet_boot.c. It paints through the console's
+ * own mapping instead of going through kprintf and the console ring, so it
+ * keeps moving when console output stops: a growing bar (colour alternates
+ * every beat) plus a white tick at the last boot stage. Empty until the
+ * framebuffer console has been probed.
+ */
+void
+sweet_fbcon_alive(unsigned int beat, int stage)
+{
+	if (fbcon_base == NULL || fbcon_height < 16 || fbcon_width < 256) {
+		return;
+	}
+	uint32_t y0 = fbcon_height - 12;
+	uint32_t width = 24 + (beat % 16) * 8;
+	uint32_t color = (beat & 1) ? 0xff00ff00u : 0xff0000ffu;
+
+	for (uint32_t y = y0; y < fbcon_height; y++) {
+		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
+		for (uint32_t x = 0; x < width && x < fbcon_width; x++) {
+			line[x] = color;
+		}
+		if (stage > 0 && stage < 60 && 24 + (uint32_t)stage * 8 + 1 < fbcon_width) {
+			uint32_t sx = 24 + (uint32_t)stage * 8;
+			line[sx] = 0xffffffffu;
+			line[sx + 1] = 0xffffffffu;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
