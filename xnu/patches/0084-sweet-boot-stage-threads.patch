diff --git a/bsd/dev/sweet_boot.c b/bsd/dev/sweet_boot.c
--- a/bsd/dev/sweet_boot.c
+++ b/bsd/dev/sweet_boot.c
@@ -1,51 +1,179 @@
 /*
  * SWEET boot progress trace.
  *
- * During bring-up the console can stop at any point and a photograph of a
- * frozen screen cannot tell a dead kernel from one that is alive with its
- * console output stuck. This adds two independent signs of life:
- *
- *  - sweet_boot_mark() prints (and remembers) the last boot milestone, so a
- *    heartbeat names the place the boot stopped at;
- *  - a kernel thread prints "SWEET ALIVE <beat> ..." every two seconds and
- *    paints a growing bar straight into the panel through the framebuffer
- *    console's mapping (pexpert/arm/pe_serial.c), bypassing the console
- *    ring, so the screen keeps changing even if console output dies.
+ * Filming a frozen screen cannot tell a dead kernel from one whose console
+ * output stopped, and one "last stage" is not enough here: driver starts run
+ * on IOKit config threads while the bootstrap thread is already in BSD init,
+ * so the two progress channels are kept apart and every mark is timed. The
+ * heartbeat then reports where each thread stands, how long the bootstrap has
+ * not moved and what the IOKit matching queue is doing.
  *
  * Boot-arg sweetheartbeat=0 disables the heartbeat thread.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
+
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <kern/thread.h>
 #include <kern/clock.h>
 #include <libkern/libkern.h>
 #include <pexpert/pexpert.h>
+#include <string.h>
 
-extern void sweet_fbcon_alive(unsigned int beat, int stage);
+extern void sweet_fbcon_alive(unsigned int beat, int stage);   /* pexpert/arm/pe_serial.c */
+void sweet_iokit_stats(int *jobs, int *threads, int *waiting); /* iokit/Kernel/IOService.cpp */
+int sweet_thread_block_info(thread_t thread, uint64_t *event, uintptr_t *kstack,
+    int *state);                                               /* osfmk/kern/sched_prim.c */
 
-volatile int sweet_boot_stage;
+volatile int    sweet_boot_stage;                   /* IOKit config threads */
 static const char *sweet_boot_label = "start";
+volatile int    sweet_main_stage;                   /* kernel_bootstrap_thread */
+static const char *sweet_main_label = "start";
+volatile unsigned int sweet_beat;
+static unsigned int sweet_main_beat;
+static thread_t sweet_main_thread;                  /* referenced, never dropped */
+#define SWEET_SIDE_THREADS  4
+static thread_t sweet_side_threads[SWEET_SIDE_THREADS];
+
+static uint64_t
+sweet_uptime_ms(void)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000ULL;
+}
 
 void
 sweet_boot_mark(int stage, const char *label)
 {
-	sweet_boot_label = label;
+	uint64_t ms = sweet_uptime_ms();
+	thread_t self = current_thread();
+
+	sweet_main_label = label;
+	sweet_main_beat = sweet_beat;
+	sweet_main_stage = stage;
+	if (sweet_main_thread != self) {
+		thread_reference(self);
+		sweet_main_thread = self;
+	}
+	printf("SWEET STAGE %d: %s @%llu.%03llus\n", stage, label,
+	    (unsigned long long)(ms / 1000ULL), (unsigned long long)(ms % 1000ULL));
+	sweet_fbcon_alive(sweet_beat, stage);
+}
+
+/*
+ * Keep a reference on each IOKit config thread that marks, so the heartbeat can
+ * still read the block state of one that is parked inside a driver's start().
+ * No lock: this runs while holding the IOKit arbitration lock, and a slot is
+ * published with one atomic swap. A lost race costs an extra reference on a
+ * still-running thread (released again right away), never a dangling pointer.
+ */
+static void
+sweet_side_track(thread_t self)
+{
+	int i;
+
+	for (i = 0; i < SWEET_SIDE_THREADS; i++) {
+		if (sweet_side_threads[i] == self) {
+			return;
+		}
+		if (sweet_side_threads[i] == NULL) {
+			thread_reference(self);
+			if (!__sync_bool_compare_and_swap(&sweet_side_threads[i], NULL, self)) {
+				thread_deallocate(self);
+			}
+			return;
+		}
+	}
+}
+
+void
+sweet_boot_side_mark(int stage, const char *label)
+{
+	uint64_t ms = sweet_uptime_ms();
+	static char buf[64];
+
+	/* The caller's name may belong to a service that goes away; keep a copy. */
+	strlcpy(buf, label != NULL ? label : "?", sizeof(buf));
+	sweet_boot_label = buf;
 	sweet_boot_stage = stage;
-	printf("SWEET STAGE %d: %s\n", stage, label);
-	sweet_fbcon_alive(0, stage);
+	sweet_side_track(current_thread());
+	printf("SWEET SIDE %d: %s @%llu.%03llus\n", stage, label,
+	    (unsigned long long)(ms / 1000ULL), (unsigned long long)(ms % 1000ULL));
+}
+
+static void
+sweet_print_block(const char *who, thread_t thread)
+{
+	uint64_t event = 0;
+	uintptr_t kstack = 0;
+	int state = 0;
+
+	if ((thread != THREAD_NULL) &&
+	    sweet_thread_block_info(thread, &event, &kstack, &state)) {
+		printf(" %s blocked: wait 0x%llx state 0x%x stack 0x%lx", who,
+		    (unsigned long long) event, (unsigned int) state,
+		    (unsigned long) kstack);
+	}
+}
+
+static thread_t
+sweet_side_last(void)
+{
+	thread_t found = THREAD_NULL;
+	int i;
+
+	for (i = 0; i < SWEET_SIDE_THREADS; i++) {
+		if (sweet_side_threads[i] != NULL) {
+			found = sweet_side_threads[i];
+		}
+	}
+	return found;
 }
 
 static void
 sweet_heartbeat(void *arg __unused, wait_result_t wr __unused)
 {
-	unsigned int beat = 0;
+	int jobs, threads, waiting;
+	int last_main = -1, last_side = -1, last_jobs = -1, last_threads = -1;
+	int changed;
 
 	for (;;) {
 		delay_for_interval(2000, 1000 * 1000);
-		beat++;
-		sweet_fbcon_alive(beat, sweet_boot_stage);
-		printf("SWEET ALIVE %u: stage %d (%s)\n", beat, sweet_boot_stage, sweet_boot_label);
+		sweet_beat++;
+		sweet_fbcon_alive(sweet_beat, sweet_main_stage);
+		sweet_iokit_stats(&jobs, &threads, &waiting);
+
+		/*
+		 * Repeat every change at once, but only echo an unchanged state every
+		 * fifth beat: the screen holds a couple of dozen lines and the
+		 * per-driver trace above this report is what identifies the stall.
+		 */
+		changed = (last_main != sweet_main_stage)
+		    || (last_side != sweet_boot_stage)
+		    || (last_jobs != jobs) || (last_threads != threads);
+		last_main = sweet_main_stage;
+		last_side = sweet_boot_stage;
+		last_jobs = jobs;
+		last_threads = threads;
+		if (!changed && ((sweet_beat % 5) != 0)) {
+			continue;
+		}
+
+		printf("SWEET ALIVE %u: main %d (%s, idle %u beats) side %d (%s) iokit jobs %d threads %d wait %d",
+		    sweet_beat, sweet_main_stage, sweet_main_label,
+		    sweet_beat - sweet_main_beat, sweet_boot_stage,
+		    sweet_boot_label, jobs, threads, waiting);
+		sweet_print_block("main", sweet_main_thread);
+		{
+			thread_t side = sweet_side_last();
+
+			if (side != THREAD_NULL) {
+				sweet_print_block("side", side);
+			}
+		}
+		printf("\n");
 	}
 }
 
@@ -63,4 +191,5 @@
 		thread_deallocate(thread);
 	}
 }
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
