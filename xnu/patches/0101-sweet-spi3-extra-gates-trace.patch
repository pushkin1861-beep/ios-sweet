+/* One byte with status samples: proves whether the-shift engine ever
+ * becomes busy (functional clock present) before any TCS traffic. */
+static void
+spi_trace_one(void)
+{
+	wr(spi, SPI_CTL0, rd(spi, SPI_CTL0) | SPI_CSN_MASK);
+	uint32_t ctl1 = rd(spi, SPI_CTL1);
+	wr(spi, SPI_CTL1, (ctl1 & ~(SPI_TX_MODE | SPI_RX_MODE)) | SPI_TX_MODE);
+	wr(spi, SPI_CTL8, 1);
+	wr(spi, SPI_CTL9, 0);
+	wr(spi, SPI_TXD, 0x00);
+	for (int i = 0; i < 6; i++) {
+		delay(1000);
+		printf("SWEET TOUCH: trace t%u raw=%x sts2=%x\n", i + 1,
+		    rd(spi, SPI_INT_RAW), rd(spi, SPI_STS2));
+	}
+	wr(spi, SPI_INT_CLR, SPI_TX_END | SPI_RX_END);
+	wr(spi, SPI_CTL1, rd(spi, SPI_CTL1) & ~(SPI_TX_MODE | SPI_RX_MODE));
+	wr(spi, SPI_CTL0, rd(spi, SPI_CTL0) & ~SPI_CS0_VALID);
+}
